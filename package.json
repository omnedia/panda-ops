{
  "name": "@omnedia/panda-ops",
  "version": "1.0.2",
  "description": "A TypeScript-based tool that analyzes pull requests and adds AI-generated review comments via the OpenAI API.",
  "type": "module",
  "main": "./main.js",
  "bin": {
    "panda-ops": "./main.js"
  },
  "scripts": {
    "build:run": "npm run build && npm run start",
    "build": "tsc && npm run copy-meta",
    "copy-meta": "copyfiles package.json README.md LICENSE dist",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "openai": "^6.38.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "4.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.9.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "copyfiles": "^2.4.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
